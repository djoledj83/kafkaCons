<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="style.css" />

    <title>Kafka Live</title>
  </head>
  <body>
    <div class="container">
      <h1>Kafka Live Cast</h1>

      <form id="tidForm">
        <input
          type="text"
          id="tidInput"
          name="tid"
          placeholder="Enter TID..."
        />
        <input type="submit" value="Submit" />
        <button id="stopConsumerBtn" type="button">Stop Consumer</button>
        <button id="logBtn" type="button">Log</button>
      </form>

      <div class="messages">
        <div id="accordionExample">
          <!-- Messages from the backend will appear here dynamically -->
        </div>
      </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="js.js"></script>
  </body>
</html>
