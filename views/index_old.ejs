<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="style.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />

    <title>Kafka Live</title>
  </head>
  <body>
    <div class="container">
      <h1>Kafka Live Cast</h1>

      <form id="tidForm">
        <input
          type="text"
          id="tidInput"
          name="tid"
          placeholder="Enter TID..."
        />
        <input type="submit" class="btn btn-success" value="Submit" />
        <button id="stopConsumerBtn" class="btn btn-danger" type="button">
          Stop Consumer
        </button>
        <button id="logBtn" class="btn btn-secondary" type="button">Log</button>
      </form>

      <div class="messages m-auto w-75">
        <div class="accordion-container">
          <div class="accordion mt-5" id="accordionExample"></div>
          <!-- Accordion container -->
        </div>
      </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="js2.js"></script>
  </body>
</html>
